# Variables de entorno de AR Tour Kaminaljuyú (iOS)
#
# En iOS estas variables se leen desde el archivo Secrets.xcconfig
# (ver src/ArTourKaminaljuyu/Secrets.xcconfig.example), que Xcode inyecta
# en Info.plist al compilar. Este archivo solo documenta los nombres.
# No colocar credenciales reales aquí.

# API Keys
GOOGLE_MAPS_API_KEY=your_google_maps_api_key
